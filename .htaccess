# Disable directory listing
Options -Indexes

<IfModule mod_headers.c>
    # Clickjacking protection
    Header always set X-Frame-Options "DENY"

    # Prevent MIME type sniffing
    Header always set X-Content-Type-Options "nosniff"

    # Hide server information
    Header unset X-Powered-By

    # Enforce CSP on ALL files, all types, all statuses
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; frame-ancestors 'none'; form-action 'self';"
</IfModule>

# Hide server signature on error pages
ServerSignature Off
