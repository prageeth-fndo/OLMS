# Disable directory browsing
Options -Indexes

<IfModule mod_headers.c>
    # Prevent clickjacking
    Header always set X-Frame-Options "DENY"

    # Enforce content type
    Header always set X-Content-Type-Options "nosniff"
   
    # Remove server signature headers
    Header unset X-Powered-By

    # Enforce CSP on ALL files, all types, all statuses
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; frame-ancestors 'none'; form-action 'self';"
</IfModule>

# Hide server version info
ServerSignature Off